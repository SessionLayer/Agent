{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sessionlayer-agent values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": { "type": "string", "pattern": "^$|^https://" },
        "serverName": { "type": "string" }
      }
    },
    "trustAnchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingConfigMap": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["token", "oidc", "mtls"] },
        "audience": { "type": "string", "minLength": 1 },
        "expirationSeconds": { "type": "integer", "minimum": 600, "maximum": 86400 },
        "existingSecret": { "type": "string" },
        "tokenKey": { "type": "string", "minLength": 1 },
        "certKey": { "type": "string", "minLength": 1 },
        "keyKey": { "type": "string", "minLength": 1 }
      }
    },
    "gateways": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpoint"],
        "properties": {
          "endpoint": { "type": "string", "pattern": "^wss://" },
          "serverName": { "type": "string" },
          "failureDomain": { "type": "string" }
        }
      }
    },
    "minControlChannels": { "type": "integer", "minimum": 1 },
    "spliceAddr": {
      "type": "string",
      "description": "A loopback IP and port: 127.0.0.0/8, or ::1 in brackets. The Agent parses this and refuses anything else, so the octets and the port are bounded here rather than merely shaped.",
      "pattern": "^(127(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|\\[(::1|(0{1,4}:){7}0{0,3}1)\\]):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3})$"
    },
    "maxConcurrentSplices": { "type": "integer", "minimum": 1 },
    "drainDeadlineSecs": { "type": "integer", "minimum": 1 },
    "dataDir": { "type": "string", "pattern": "^/" },
    "requireFullLandlock": { "type": "boolean" },
    "hostNetwork": { "type": "boolean" },
    "dnsPolicy": { "enum": ["", "ClusterFirst", "ClusterFirstWithHostNet", "Default", "None"] },
    "extraArgs": { "type": "array", "items": { "type": "string" } },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "updateStrategy": { "type": "object" },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "controlPlanePodSelector": { "type": "object" },
        "controlPlaneGrpcPort": { "$ref": "#/definitions/port" },
        "gatewayPodSelector": { "type": "object" },
        "gatewayPort": { "$ref": "#/definitions/port" },
        "dnsNamespaceSelector": { "type": "object" },
        "dnsPodSelector": { "type": "object" },
        "gatewayCidrs": { "$ref": "#/definitions/cidrList" },
        "extraEgress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "extraEnv": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } }
  },
  "definitions": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "cidrList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$"
      }
    }
  }
}
